table fato_vendas
	lineageTag: baf1f68a-7267-4760-a7a6-c95acd322a0f

	/// Soma da venda bruta (antes do desconto).
	measure 'Vendas Brutas' = SUM(fato_vendas[venda_bruta])
		formatString: "R$"\ #,0.00
		displayFolder: 1 Vendas
		lineageTag: ec6a3430-1acf-426b-ad92-9f2b64699b0f

	/// Soma dos descontos concedidos.
	measure Descontos = SUM(fato_vendas[desconto])
		formatString: "R$"\ #,0.00
		displayFolder: 1 Vendas
		lineageTag: ce7b7193-d2b2-4e06-a81a-79a34bb996b5

	/// Venda bruta menos descontos.
	measure 'Vendas Líquidas' = SUM(fato_vendas[venda_liquida])
		formatString: "R$"\ #,0.00
		displayFolder: 1 Vendas
		lineageTag: 6cb5f7c7-0aa7-4a97-bd35-8eaef7aebcc2

	/// Quantidade vendida.
	measure 'Quantidade Vendida' = SUM(fato_vendas[quantidade])
		formatString: #,0.00
		displayFolder: 1 Vendas
		lineageTag: 7904d25b-1f13-41d7-aac5-40f7ba730fd1

	/// Documentos distintos (n_doc). Nao afirmamos que 1 documento = 1 pedido.
	measure Documentos = DISTINCTCOUNT(fato_vendas[n_doc])
		formatString: #,0
		displayFolder: 1 Vendas
		lineageTag: d1af31e5-b467-4679-a434-986c702811d9

	/// Vendas liquidas por documento.
	measure 'Ticket Médio' = DIVIDE([Vendas Líquidas], [Documentos])
		formatString: "R$"\ #,0.00
		displayFolder: 1 Vendas
		lineageTag: 26018c64-45f3-4435-b2b3-61fab79b6c92

	/// Desconto sobre a venda bruta.
	measure 'Desconto %' = DIVIDE([Descontos], [Vendas Brutas])
		formatString: 0.0%
		displayFolder: 1 Vendas
		lineageTag: 4257a6e0-83d6-4fd4-b781-ae6084eb13d4

	/// Vendas liquidas no mes anterior ao periodo selecionado.
	measure 'Vendas Mês Anterior' = CALCULATE([Vendas Líquidas], DATEADD(dim_data[data], -1, MONTH))
		formatString: "R$"\ #,0.00
		displayFolder: 2 Comparação
		lineageTag: a232dff2-2385-49fa-8cc6-557223c5aa69

	/// Diferenca em R$ para o mes anterior (vazio se nao houver mes anterior).
	measure 'Variação vs Mês Anterior' = VAR anterior = [Vendas Mês Anterior] RETURN IF(NOT ISBLANK(anterior), [Vendas Líquidas] - anterior)
		formatString: "R$"\ #,0.00
		displayFolder: 2 Comparação
		lineageTag: a9eb224b-c402-45c1-bc7b-ea9875f20cee

	/// Diferenca percentual para o mes anterior.
	measure 'Variação % vs Mês Anterior' = DIVIDE([Variação vs Mês Anterior], [Vendas Mês Anterior])
		formatString: 0.0%
		displayFolder: 2 Comparação
		lineageTag: 5a446954-7e4c-49c4-8cac-79ba6ade23a1

	/// Vendas liquidas no mesmo periodo do ano anterior.
	measure 'Vendas Ano Anterior' = CALCULATE([Vendas Líquidas], SAMEPERIODLASTYEAR(dim_data[data]))
		formatString: "R$"\ #,0.00
		displayFolder: 2 Comparação
		lineageTag: 5e3e14f5-8e84-4015-9d25-1d865a996f49

	/// Ultima data com venda carregada. Mostrar no contexto do filtro.
	measure 'Dados até' = CALCULATE(MAX(fato_vendas[movimento]), ALL(dim_data))
		formatString: dd/mm/yyyy
		displayFolder: 3 Contexto
		lineageTag: 67df2d03-1e95-4d24-9370-bc44c49a0038

